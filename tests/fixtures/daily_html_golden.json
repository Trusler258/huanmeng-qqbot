px;line-height:1.6;-webkit-font-smoothing:antialiased}\n.wrap{padding:24px 20px 30px}\n.card{position:relative;background:var(--bg-card);border-radius:var(--radius);backdrop-filter:blur(24px) saturate(1.4);-webkit-backdrop-filter:blur(24px) saturate(1.4);box-shadow:0 12px 48px rgba(0,0,0,0.65),0 0 100px rgba(236,72,153,0.10),0 0 40px rgba(139,92,246,0.08),inset 0 1px 0 rgba(255,255,255,0.12),inset 0 -1px 0 rgba(0,0,0,0.3);overflow:hidden}\n.card::before{content:'';position:absolute;inset:0;border-radius:var(--radius);padding:1px;background:linear-gradient(135deg,rgba(236,72,153,0.55) 0%,rgba(139,92,246,0.40) 35%,rgba(86,134,254,0.30) 65%,rgba(34,211,238,0.35) 100%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none;z-index:2}\n.card::after{content:'';position:absolute;top:0;left:15%;right:15%;height:2px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.7),transparent);filter:blur(0.5px);z-index:3}\n.head{padding:24px 28px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:16px;position:relative}\n.head::after{content:'';position:absolute;bottom:-1px;left:28px;right:28px;height:1px;background:linear-gradient(90deg,transparent,rgba(236,72,153,0.5) 30%,rgba(139,92,246,0.4) 70%,transparent)}\n.logo{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;background:linear-gradient(135deg,rgba(236,72,153,0.35),rgba(139,92,246,0.20)),radial-gradient(circle at 30% 30%,rgba(255,255,255,0.15),transparent 60%);border:1px solid rgba(236,72,153,0.45);box-shadow:0 4px 20px rgba(236,72,153,0.35),inset 0 1px 0 rgba(255,255,255,0.2);flex-shrink:0}\n.head-text{flex:1;min-width:0}\n.head-title{font-size:20px;font-weight:800;letter-spacing:0.3px;display:flex;align-items:baseline;gap:10px}\n.head-title .nm{background:linear-gradient(135deg,#f472b6 0%,#ec4899 40%,#8b5cf6 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 12px rgba(236,72,153,0.4))}\n.head-title .sl{color:var(--text-3);font-weight:300;-webkit-text-fill-color:var(--text-3)}\n.head-title .tp{font-family:var(--mono);font-size:12px;font-weight:500;color:var(--text-2);letter-spacing:1.8px;text-transform:uppercase;-webkit-text-fill-color:var(--text-2)}\n.head-sub{font-family:var(--mono);font-size:11px;color:var(--text-3);margin-top:5px;letter-spacing:0.3px}\n.head-tag{font-family:var(--mono);font-size:11px;color:#fff;background:linear-gradient(135deg,rgba(236,72,153,0.25),rgba(139,92,246,0.20));border:1px solid rgba(236,72,153,0.45);padding:5px 12px;border-radius:20px;letter-spacing:0.3px;white-space:nowrap;box-shadow:0 4px 14px rgba(236,72,153,0.25),inset 0 1px 0 rgba(255,255,255,0.15)}\n.summary{display:flex;gap:1px;background:var(--border);border-bottom:1px solid var(--border)}\n.sum-item{flex:1;background:rgba(20,18,32,0.4);padding:16px 8px 12px;text-align:center}\n.sum-num{font-family:var(--mono);font-size:24px;font-weight:800;color:var(--text);letter-spacing:0.5px;line-height:1.1}\n.sum-num.c-pink{color:var(--primary-light);text-shadow:0 0 14px rgba(244,114,182,0.5)}\n.sum-num.c-purple{color:var(--accent-light);text-shadow:0 0 14px rgba(167,139,250,0.5)}\n.sum-num.c-amber{color:var(--warning);text-shadow:0 0 14px rgba(251,191,36,0.5)}\n.sum-num.c-green{color:var(--success);text-shadow:0 0 14px rgba(52,211,153,0.5)}\n.sum-lbl{font-family:var(--mono);font-size:9.5px;color:var(--text-3);margin-top:4px;letter-spacing:0.8px;text-transform:uppercase}\n.sec{padding:16px 28px 6px;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--text-2);letter-spacing:1px;text-transform:uppercase;display:flex;align-items:center;gap:8px}\n.sec::before{content:'';width:3px;height:13px;background:linear-gradient(180deg,var(--primary),var(--accent));border-radius:2px;box-shadow:0 0 6px rgba(236,72,153,0.4)}\n.sec-cn{font-family:var(--sans);font-size:13px;font-weight:600;color:var(--text);letter-spacing:0.3px;text-transform:none}\n.rank-list{padding:4px 28px 8px}\n.rrow{display:flex;align-items:center;gap:10px;padding:7px 12px;margin-bottom:3px;border-radius:var(--radius-s);background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.04)}\n.rnum{width:24px;font-family:var(--mono);font-size:13px;font-weight:800;text-align:center;color:var(--text-3);flex-shrink:0}\n.rnum.r1{color:var(--gold);text-shadow:0 0 8px rgba(251,191,36,0.6)}\n.rnum.r2{color:var(--silver);text-shadow:0 0 6px rgba(203,213,225,0.4)}\n.rnum.r3{color:var(--bronze);text-shadow:0 0 6px rgba(217,119,6,0.4)}\n.rname{width:96px;font-size:13px;color:var(--text);flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.rbar-w{flex:1;height:16px;background:rgba(255,255,255,0.05);border-radius:8px;overflow:hidden;position:relative;border:1px solid rgba(255,255,255,0.03)}\n.rbar{height:100%;background:linear-gradient(90deg,var(--primary),var(--primary-light));border-radius:8px;box-shadow:0 0 8px rgba(236,72,153,0.4)}\n.rbar.rb1{background:linear-gradient(90deg,var(--gold),#fde68a);box-shadow:0 0 8px rgba(251,191,36,0.5)}\n.rbar.rb2{background:linear-gradient(90deg,var(--silver),#e2e8f0);box-shadow:0 0 6px rgba(203,213,225,0.3)}\n.rbar.rb3{background:linear-gradient(90deg,var(--bronze),var(--gold));box-shadow:0 0 6px rgba(217,119,6,0.4)}\n.rcnt{font-family:var(--mono);font-size:11px;font-weight:700;color:var(--text-2);width:40px;text-align:right;flex-shrink:0}\n.hours{display:flex;gap:2px;padding:4px 28px 12px;align-items:stretch}\n.hr-c{flex:1;height:24px;border-radius:3px;background:rgba(255,255,255,0.04);position:relative}\n.hr-c.l1{background:rgba(236,72,153,0.22)}\n.hr-c.l2{background:rgba(236,72,153,0.40)}\n.hr-c.l3{background:rgba(236,72,153,0.60)}\n.hr-c.l4{background:rgba(236,72,153,0.80)}\n.hr-c.l5{background:var(--primary);box-shadow:0 0 8px rgba(236,72,153,0.6)}\n.hours-labels{display:flex;padding:0 28px 12px;font-family:var(--mono);font-size:9px;color:var(--text-3);letter-spacing:0.3px}\n.hours-labels span{flex:1;text-align:center}\n.hours-labels span:first-child{text-align:left}\n.hours-labels span:last-child{text-align:right}\n.facts{padding:4px 28px 10px}\n.fn-it{font-size:12.5px;color:var(--text-2);line-height:1.6;padding:7px 14px;margin-bottom:3px;border-left:2px solid var(--border);background:rgba(255,255,255,0.02);border-radius:0 var(--radius-s) var(--radius-s) 0}\n.fn-it strong{color:var(--primary-light);font-weight:700}\n.foot{padding:14px 28px 18px;border-top:1px solid var(--border);background:linear-gradient(180deg,rgba(0,0,0,0.15),rgba(0,0,0,0.30));display:flex;align-items:center;justify-content:space-between;position:relative}\n.foot::before{content:'';position:absolute;top:0;left:28px;right:28px;height:1px;background:linear-gradient(90deg,transparent,rgba(236,72,153,0.4) 30%,rgba(139,92,246,0.3) 70%,transparent)}\n.foot-l{font-family:var(--mono);font-size:10px;color:var(--text-3);display:flex;align-items:center;gap:8px}\n.foot-l .dot{width:7px;height:7px;background:var(--success);border-radius:50%;display:inline-block;box-shadow:0 0 10px rgba(52,211,153,0.7),0 0 4px rgba(52,211,153,0.9)}\n.foot-l .pk{color:var(--primary-light)}\n.foot-r{font-family:var(--mono);font-size:10px;font-weight:700;background:linear-gradient(135deg,var(--primary),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:2px;text-transform:uppercase;opacity:0.7}\n</style>\n</head>\n<body>\n<div class=\"wrap\"><div class=\"card\">\n<div class=\"head\">\n<div class=\"logo\">📊</div>\n<div class=\"head-text\">\n<div class=\"head-title\"><span class=\"nm\">幻梦</span><span class=\"sl\">·</span><span class=\"tp\">DAILY REPORT</span></div>\n<div class=\"head-sub\">123456789 · 2026.09.27</div>\n</div>\n<div class=\"head-tag\">测试群名</div>\n</div>\n<div class=\"summary\">\n<div class=\"sum-item\"><div class=\"sum-num c-pink\">386</div>