# .env — API 密钥（bot_config.toml 中 provider 的值决定读取哪个 KEY）
# 复制为 .env 并填入真实密钥

# DeepSeek
DEEPSEEK_KEY=sk-xxxxxxxx
DEEPSEEK_URL=https://api.deepseek.com

# SiliconFlow（如需）
SILICONFLOW_KEY=sk-xxxxxxxx
SILICONFLOW_URL=https://api.siliconflow.cn/v1

# 智谱（如需图片识别用）
ZHIPU_KEY=xxx
ZHIPU_URL=https://open.bigmodel.cn/api/paas/v4

# 插件库地址（.hmp 分发服务；仓库里不写死主机，必须在部署环境配）
# 例：PLUGIN_LIB_BASE=http://your-host:20030
PLUGIN_LIB_BASE=

# PC 状态上报的目标主机（scripts/pc_status_reporter.py 用）
BOT_SERVER=
